# ---------------------------------------------------------------------------
# Copy to .env and fill in. Every value below has a working default except
# ANTHROPIC_API_KEY (required when LLM_PROVIDER=claude).
# ---------------------------------------------------------------------------

APP_ENV=dev
LOG_LEVEL=INFO

# --- LLM provider: claude | ollama -----------------------------------------
LLM_PROVIDER=claude
ANTHROPIC_API_KEY=

# if using ollama — run it locally first:
#   ollama pull llama3.1
#   ollama serve
OLLAMA_MODEL=llama3.1
OLLAMA_BASE_URL=http://localhost:11434

# --- Embeddings ------------------------------------------------------------
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIM=768

# --- Vector store: pgvector | qdrant ---------------------------------------
# pgvector is the default and the only backend bundled in docker-compose.
# qdrant requires `pip install -e ".[qdrant]"` and your own Qdrant instance.
VECTOR_STORE=pgvector
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ragbot
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=documents

# --- Retrieval -------------------------------------------------------------
RETRIEVAL_TOP_K=6
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
DOCUMENTS_DIR=data/documents

# --- Observability (self-hosted Langfuse) ----------------------------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000

# --- Auth: local | jwt -----------------------------------------------------
# local: no tokens, no login — every request gets the fixed principal below.
# jwt:   verify a bearer token; mint one with `python -m scripts.make_token`.
AUTH_MODE=local
LOCAL_USER_ID=local-user
LOCAL_TENANT_ID=default
JWT_SECRET=
JWT_ALGORITHM=HS256
